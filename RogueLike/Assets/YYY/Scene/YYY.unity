  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3053\u3093\u306A\u72ED\u3044\u6240\u306B\u5165\u3063\u3066\u304D\u3066\u2026\u2026\u306D\u3048\u3001\u79C1\u306B\u89E6\u3089\u308C\u305F\u304F\u3066\u6765\u305F\u306E\uFF1F"
  C_1: "\u7279\u610F\u95EF\u5230\u6211\u4EEC\u8FD9\u91CC\u2026\u2026\u4F60\u662F\u4E0D\u662F\u6545\u610F\u60F3\u8BA9\u6211\u78B0\u4F60\uFF1F"
  C_2: "\u7279\u5730\u95D6\u9032\u4F86\u2026\u2026\u4F60\u8A72\u4E0D\u6703\u662F\u60F3\u88AB\u6211\u6478\u5427\uFF1F"
  E: "You came all the way in here\u2026 what, hoping I\u2019d touch you or something?"
  K: "\uC5EC\uAE30\uAE4C\uC9C0 \uB4E4\uC5B4\uC628 \uAC70 \uBCF4\uB2C8\u2026 \uB0B4
    \uC190\uB9DB\uC774 \uAD81\uAE08\uD55C \uAC70\uC57C?"
  isTyped: 1
