--- !u!114 &827233228
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 827233226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3075\u3075\u3001\u6CE3\u304F\u306A\u3063\u3066\u3002\u3053\u308C\u304B\u3089\u304C\u672C\u756A\u3060\u308D\uFF1F
    \u3053\u306E\u53F0\u306B\u7E1B\u3063\u3066\u3084\u308B\u3088"
  C_1: "\u563F\uFF0C\u522B\u54ED\u554A\u3002\u73B0\u5728\u624D\u521A\u5F00\u59CB\u5462\u3002\u6765\uFF0C\u6211\u628A\u4F60\u7ED1\u4E0A\u8FD9\u5F20\u62F7\u95EE\u53F0"
  C_2: "\u563F\uFF0C\u5225\u54ED\u554A\u3002\u73FE\u5728\u624D\u525B\u958B\u59CB\u5462\u3002\u4F86\uFF0C\u6211\u628A\u4F60\u7D81\u4E0A\u9019\u5F35\u62F7\u554F\u53F0"
  E: "Don\u2019t cry now. We\u2019re just getting started. Let\u2019s tie you down
    nice and tight."
  K: "\uC6B8\uAE34 \uC65C \uC6B8\uC5B4? \uC774\uC81C\uBD80\uD130\uAC00 \uC9C4\uC9DC\uC57C.
    \uC774 \uACE0\uBB38\uB300\uC5D0 \uAF41\uAF41 \uBB36\uC5B4\uC904\uAC8C."
  isTyped: 1
