--- !u!114 &1975898244
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1975898242}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30A8\u30EB\u30D5\u306E\u6751\u304B\u3089\u7565\u596A\u3055\u308C\u3066\u304D\u305F\u5973\u5974\u96B7\u306E\u591A\u304F\u306F\u3053\u3053\u306B\u76E3\u7981\u3055\u308C\u3066\u3044\u308B\u3002\u3082\u3057\u5F7C\u5973\u305F\u3061\u3092\u89E3\u653E\u3067\u304D\u308C\u3070\u3001\u65B0\u305F\u306A\u6226\u529B\u3092\u5F97\u3089\u308C\u308B\u3060\u308D\u3046\u2026\u2026"
  C_1: "\u4ECE\u7CBE\u7075\u6751\u5E84\u52AB\u63A0\u8D70\u7684\u5973\u5974\u96B6\u4EEC\u5927\u591A\u88AB\u5173\u62BC\u5728\u8FD9\u91CC\uFF0C\u5982\u679C\u80FD\u591F\u89E3\u6551\u5979\u4EEC\uFF0C\u5C31\u80FD\u83B7\u5F97\u65B0\u7684\u6218\u529B\u2026\u2026"
  C_2: "\u5F9E\u7CBE\u9748\u6751\u838A\u52AB\u63A0\u8D70\u7684\u5973\u5974\u96B8\u5011\u5927\u591A\u88AB\u95DC\u62BC\u5728\u9019\u88E1\uFF0C\u5982\u679C\u80FD\u5920\u89E3\u6551\u5979\u5011\uFF0C\u5C31\u80FD\u7372\u5F97\u65B0\u7684\u6230\u529B\u2026\u2026"
  E: "Most of the enslaved elven women taken from their villages are imprisoned here.
    If you can rescue them, they may become valuable allies\u2026"
  K: "\uC5D8\uD504 \uB9C8\uC744\uC5D0\uC11C \uC57D\uD0C8\uB2F9\uD55C \uC5EC\uB178\uC608\uB4E4\uC740
    \uB300\uBD80\uBD84 \uC774\uACF3\uC5D0 \uAC10\uAE08\uB418\uC5B4 \uC788\uB2E4.
    \uB9CC\uC57D \uADF8\uB140\uB4E4\uC744 \uAD6C\uCD9C\uD560 \uC218 \uC788\uB2E4\uBA74,
    \uC0C8\uB85C\uC6B4 \uC804\uB825\uC744 \uC5BB\uC744 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4\u2026\u2026"
  isTyped: 0
