  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3048\u3063\u2026\u2026\u5618\u3002\u3042\u306A\u305F\u3001\u7537\uFF1F\u2026\u2026\u3075\u3075\u3001\u3082\u3063\u3068\u597D\u304D\u306B\u306A\u3063\u305F\u2661"
  C_1: "\u300C\u8BF6\uFF1F\u2026\u2026\u4F60\u662F\u7537\u7684\uFF1F\u2026\u2026\u5475\u5475\uFF0C\u6211\u66F4\u559C\u6B22\u4E86\u5462\u2661"
  C_2: "\u6B38\uFF1F\u2026\u2026\u4F60\u662F\u7537\u7684\uFF1F\u2026\u2026\u5475\u5475\uFF0C\u6211\u66F4\u611B\u4E86\u5462\u2661"
  E: "Wait\u2026 you\u2019re a guy? Oh, I like you even more now~\u2661"
  K: "\uC5B4\uBA38\u2026 \uB0A8\uC790\uC600\uC5B4? \uD6C4\uD6D7, \uB354 \uB9C8\uC74C\uC5D0
    \uB4DC\uB124~\u2661"
  isTyped: 1
