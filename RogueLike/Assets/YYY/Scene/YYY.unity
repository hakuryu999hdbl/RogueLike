--- !u!114 &1729459239
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1729459236}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u898B\u308D\u2026\u2026\u611B\u3057\u304D\u5E7C\u99B4\u67D3\u304C\u3001\u3069\u3093\u306A\u306B\u201C\u4E0A\u7B49\u306A\u5546\u54C1\u201D\u3078\u3068\u4ED5\u4E0A\u304C\u3063\u305F\u304B"
  C_1: "\u770B\u5427\u2026\u2026\u4F60\u90A3\u631A\u7231\u7684\u9752\u6885\u7AF9\u9A6C\uFF0C\u5982\u4ECA\u5DF2\u88AB\u6211\u6539\u9020\u6210\u591A\u4E48\u201C\u9AD8\u7EA7\u7684\u5546\u54C1\u201D\u3002"
  C_2: "\u770B\u5427\u2026\u2026\u59B3\u90A3\u646F\u611B\u7684\u9752\u6885\u7AF9\u99AC\uFF0C\u5982\u4ECA\u5DF2\u88AB\u6211\u6539\u9020\u6210\u591A\u9EBC\u300C\u9AD8\u7D1A\u7684\u5546\u54C1\u300D\u3002"
  E: "Look\u2014your beloved childhood friend has been perfected into such a \u201Cfine
    product.\u201D"
  K: "\uBD10\uB77C\u2026\u2026 \uB124\uAC00 \uC0AC\uB791\uD588\uB358 \uC18C\uAFC9\uCE5C\uAD6C\uAC00
    \uC5BC\uB9C8\uB098 \u201C\uACE0\uAE09\uC2A4\uB7EC\uC6B4 \uC0C1\uD488\u201D\uC73C\uB85C
    \uC644\uC131\uB418\uC5C8\uB294\uC9C0."
  isTyped: 1
