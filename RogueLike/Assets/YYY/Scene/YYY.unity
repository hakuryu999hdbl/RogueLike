--- !u!114 &1902629220
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1902629218}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u6DEB\u5A66\u3092\u6652\u3057\u3001\u516C\u958B\u63A5\u5BA2\u3055\u305B\u308B\u305F\u3081\u306E\u56DB\u8F2A\u306E\u8ECA\u3002
    \u6728\u67B7\u3084\u958B\u811A\u5668\u3067M\u5B57\u306B\u62D8\u675F\u3055\u308C\u305F\u5974\u96B7\u306F\u3001\u88F8\u306B\u3055\u308C\u3001\u30B9\u30C8\u30C3\u30AD\u30F3\u30B0\u3084\u30CF\u30A4\u30D2\u30FC\u30EB\u306E\u307F\u6B8B\u3055\u308C\u308B\u3002\u585E\u304C\u308C\u305F\u53E3\u304B\u3089\u306F\u547B\u304D\u3057\u304B\u6F0F\u308C\u305A\u3001\u4F53\u6DB2\u306F\u5E8A\u306E\u7A74\u3078\u6EF4\u308A\u843D\u3061\u308B\u3002
    \u898B\u4E16\u7269\u3068\u3057\u3066\u5E02\u4E2D\u3092\u5F15\u304D\u56DE\u3055\u308C\u3001\u6700\u5F8C\u306B\u306F\u5E83\u5834\u3067\u7FA4\u8846\u306B\u9806\u756A\u306B\u72AF\u3055\u308C\u3066\u3044\u304F\u3002"
  C_1: "\u7528\u4E8E\u7F9E\u8FB1\u6DEB\u5987\u5E76\u5F3A\u5236\u516C\u5F00\u63A5\u5BA2\u7684\u56DB\u8F6E\u8F66\u3002
    \u5974\u96B6\u88AB\u6728\u67B7\u4E0E\u5F00\u811A\u5668\u675F\u7F1A\u6210 M \u5B57\u59FF\u52BF\uFF0C\u5265\u5149\u8863\u7269\uFF0C\u4EC5\u7559\u4E1D\u889C\u4E0E\u9AD8\u8DDF\u978B\u3002
    \u5835\u4F4F\u7684\u53E3\u4E2D\u53EA\u80FD\u53D1\u51FA\u547B\u541F\uFF0C\u4F53\u6DB2\u987A\u7740\u8F66\u677F\u7684\u5B54\u6D1E\u6EF4\u843D\u3002
    \u5979\u4EEC\u88AB\u5F53\u4F5C\u8868\u6F14\u5728\u5E02\u4E2D\u6E38\u884C\uFF0C\u6700\u7EC8\u5728\u5E7F\u573A\u4E0A\u88AB\u7FA4\u4F17\u4F9D\u6B21\u8E42\u8E8F\u3002"
  C_2: "\u7528\u65BC\u7F9E\u8FB1\u6DEB\u5A66\u4E26\u5F37\u5236\u516C\u958B\u63A5\u5BA2\u7684\u56DB\u8F2A\u8ECA\u3002
    \u5974\u96B8\u88AB\u6728\u67B7\u8207\u958B\u8173\u5668\u675F\u7E1B\u6210 M \u5B57\u59FF\u52E2\uFF0C\u525D\u5149\u8863\u7269\uFF0C\u53EA\u7559\u4E0B\u7D72\u896A\u8207\u9AD8\u8DDF\u978B\u3002
    \u5835\u4F4F\u7684\u53E3\u4E2D\u53EA\u80FD\u767C\u51FA\u547B\u541F\uFF0C\u9AD4\u6DB2\u9806\u8457\u8ECA\u677F\u7684\u5B54\u6D1E\u6EF4\u843D\u3002
    \u5979\u5011\u88AB\u7576\u4F5C\u8868\u6F14\u5728\u5E02\u4E2D\u904A\u884C\uFF0C\u6700\u7D42\u65BC\u5EE3\u5834\u4E0A\u88AB\u7FA4\u773E\u4F9D\u6B21\u8E42\u8EAA\u3002"
  E: A four-wheeled cart to expose women and force public service. Slaves are bound
    in M-shaped poses with pillories and spreader bars, stripped naked save for stockings
    and heels.
  K: "\uC74C\uBD80\uB97C \uB4DC\uB7EC\uB0B4\uACE0 \uAC15\uC81C\uB85C \uACF5\uAC1C
    \uC811\uAC1D\uC2DC\uD0A4\uB294 \uB124 \uBC14\uD034 \uC218\uB808. \uB178\uC608\uB4E4\uC740
    \uBAA9\uD2C0\uACFC \uAC1C\uAC01\uAE30\uB85C M\uC790 \uC790\uC138\uB85C \uBB36\uC5EC,
    \uC54C\uBAB8\uC774 \uB418\uACE0 \uC2A4\uD0C0\uD0B9\uACFC \uD558\uC774\uD790\uB9CC
    \uB0A8\uB294\uB2E4. \uB9C9\uD78C \uC785\uC5D0\uC11C\uB294 \uC2E0\uC74C\uB9CC
    \uD758\uB7EC\uB098\uC624\uACE0, \uCCB4\uC561\uC740 \uBC14\uB2E5 \uAD6C\uBA4D\uC73C\uB85C
    \uD758\uB7EC\uB0B4\uB9B0\uB2E4. \uADF8\uB140\uB4E4\uC740 \uAD6C\uACBD\uAC70\uB9AC\uB85C
    \uAC70\uB9AC\uB97C \uB04C\uB824 \uB2E4\uB2C8\uB2E4\uAC00, \uACB0\uAD6D \uAD11\uC7A5\uC5D0\uC11C
    \uAD70\uC911\uC5D0\uAC8C \uCC28\uB840\uB85C \uB2A5\uC695\uB2F9\uD55C\uB2E4."
  isTyped: 0
