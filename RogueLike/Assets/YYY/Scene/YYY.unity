  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u7537\u3067\u3082\u5973\u3067\u3082\u306A\u3044\u2026\u2026\u7A62\u308C\u305D\u306E\u3082\u306E\u3002"
  C_1: "\u4F60\u65E2\u975E\u7537\u4E5F\u975E\u5973\u2026\u2026\u4F60\u5C31\u662F\u6C61\u79FD\u672C\u8EAB\u3002"
  C_2: "\u6C5D\u975E\u7537\u975E\u5973\u2026\u2026\u5373\u662F\u7A62\u9748\u3002"
  E: "Neither man nor woman\u2026 you're corruption incarnate."
  K: "\uB0A8\uC790\uB3C4 \uC5EC\uC790\uB3C4 \uC544\uB2CC\u2026 \uC624\uC5FC\uC758
    \uD654\uC2E0\uC774\uB2E4."
  isTyped: 1
