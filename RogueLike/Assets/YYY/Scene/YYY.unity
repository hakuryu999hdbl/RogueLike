--- !u!114 &1132879711
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1132879708}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u6211\u304C\u540D\u306F\u30A2\u30EC\u30AF\u30B7\u30B9\uFF1D\u30F4\u30A1\u30EB\u30C9\u30EA\u30F3\u3002\u5E1D\u56FD\u306E\u6B63\u7FA9\u3092\u3001\u3053\u306E\u5203\u3067\u793A\u305D\u3046\u3002"
  C_1: "\u543E\u540D\u4E3A \u4E9A\u5386\u514B\u897F\u65AF\xB7\u74E6\u5C14\u5FB7\u6797\u3002\u4EE5\u6B64\u5203\uFF0C\u662D\u793A\u5E1D\u56FD\u7684\u6B63\u4E49\u3002"
  C_2: "\u543E\u540D\u70BA \u4E9E\u6B77\u514B\u897F\u65AF\xB7\u74E6\u723E\u5FB7\u6797\u3002\u4EE5\u6B64\u5203\uFF0C\u5C55\u73FE\u5E1D\u570B\u7684\u6B63\u7FA9\u3002"
  E: "I am Alexis Valdrin. With this blade, I will demonstrate the Empire\u2019s
    justice."
  K: "\uB098\uB294 \uC54C\uB809\uC2DC\uC2A4\uFF1D\uBC1C\uB4DC\uB9B0\uC774\uB2E4.
    \uC774 \uCE7C\uB85C \uC81C\uAD6D\uC758 \uC815\uC758\uB97C \uBCF4\uC5EC\uC8FC\uACA0\uB2E4."
  isTyped: 1
