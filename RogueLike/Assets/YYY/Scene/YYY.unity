  J: "\u3088\u3046\u3053\u305D\u2026\u2026\u8840\u3068\u95C7\u306E\u5100\u5F0F\u3078\u3002"
  C_1: "\u6B22\u8FCE\u6765\u5230\u2026\u2026\u8840\u4E0E\u9ED1\u6697\u7684\u4EEA\u5F0F\u3002"
