--- !u!114 &1366278421
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1366278419}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u6DEB\u7F6A\u8056\u4F1A\u306B\u5C5E\u3057\u3001\u6DEB\u4E71\u7F6A\u3092\u72AF\u3057\u305F\u8005\u306B\u5BFE\u3057\u3066\u53B3\u683C\u306A\u300C\u6DEB\u7F6A\u88C1\u5224\u300D\u3092\u884C\u3044\u307E\u3059\u3002\u5F7C\u5973\u305F\u3061\u306E\u51E6\u7F70\u306F\u7121\u7BC0\u5236\u3067\u3001\u5012\u5341\u5B57\u67B6\u62D8\u675F\u3084\u7DCA\u7E1B\u7F9E\u8FB1\u3001\u8056\u6CB9\u306E\u704C\u5165\u3092\u901A\u3058\u3066\u3001\u8089\u4F53\u3068\u7CBE\u795E\u3092\u6975\u7AEF\u306B\u8A66\u3055\u308C\u307E\u3059\u3002\u3053\u306E\u904E\u9177\u306A\u5100\u5F0F\u306F\u3001\u6B32\u671B\u3092\u6D44\u5316\u3057\u3001\u7F6A\u3092\u6D17\u3044\u6D41\u3059\u3068\u3055\u308C\u3066\u3044\u307E\u3059\u304C\u3001\u6DF1\u3044\u5C48\u8FB1\u3068\u5FEB\u697D\u3092\u4F34\u3046\u3082\u306E\u3068\u306A\u3063\u3066\u3044\u307E\u3059\u3002"
  C_1: "\u6DEB\u7F6A\u5723\u4F1A\u6240\u5C5E\uFF0C\u5979\u4EEC\u5BF9\u72AF\u4E0B\u6DEB\u4E71\u7F6A\u7684\u4EBA\u6267\u884C\u4E25\u683C\u7684\u201C\u6DEB\u7F6A\u5BA1\u5224\u201D\u3002\u5979\u4EEC\u7684\u60E9\u7F5A\u6BEB\u65E0\u8282\u5236\uFF0C\u901A\u8FC7\u5012\u5341\u5B57\u67B6\u62D8\u675F\u3001\u7D27\u7F1A\u7F9E\u8FB1\u4EE5\u53CA\u5723\u6CB9\u704C\u5165\uFF0C\u5BF9\u8089\u4F53\u548C\u7CBE\u795E\u8FDB\u884C\u6781\u7AEF\u8003\u9A8C\u3002\u8FD9\u4E00\u4E25\u9177\u7684\u4EEA\u5F0F\u636E\u8BF4\u80FD\u51C0\u5316\u6B32\u671B\u3001\u6D17\u6DA4\u7F6A\u5B7D\uFF0C\u4F46\u5374\u4F34\u968F\u7740\u6DF1\u523B\u7684\u5C48\u8FB1\u4E0E\u5FEB\u611F\u3002"
  C_2: "\u6DEB\u7F6A\u8056\u6703\u6240\u5C6C\uFF0C\u5979\u5011\u5C0D\u72AF\u4E0B\u6DEB\u4E82\u7F6A\u7684\u4EBA\u57F7\u884C\u56B4\u683C\u7684\u300C\u6DEB\u7F6A\u5BE9\u5224\u300D\u3002\u5979\u5011\u7684\u61F2\u7F70\u6BEB\u7121\u7BC0\u5236\uFF0C\u901A\u904E\u5012\u5341\u5B57\u67B6\u62D8\u675F\u3001\u7DCA\u7E1B\u7F9E\u8FB1\u4EE5\u53CA\u8056\u6CB9\u704C\u5165\uFF0C\u5C0D\u8089\u9AD4\u548C\u7CBE\u795E\u9032\u884C\u6975\u7AEF\u8A66\u7149\u3002\u9019\u4E00\u56B4\u9177\u7684\u5100\u5F0F\u64DA\u8AAA\u80FD\u6DE8\u5316\u6B32\u671B\u3001\u6D17\u6ECC\u7F6A\u5B7D\uFF0C\u4F46\u537B\u4F34\u96A8\u8457\u6DF1\u523B\u7684\u5C48\u8FB1\u8207\u5FEB\u611F\u3002"
  E: They conduct strict "Lewd Sin Trials" against those who commit acts of lewd
    sin. Their punishments are unrestrained, subjecting the body and mind to extreme
    trials through inverted cross restraint, bondage humiliation, and the infusion
    of holy oil.
  K: "\uC74C\uB780\uC8C4 \uB2E8\uCCB4\uC5D0 \uC18D\uD574, \uC74C\uB780\uC8C4\uB97C
    \uC800\uC9C0\uB978 \uC790\uB4E4\uC5D0\uAC8C \uC5C4\uACA9\uD55C '\uC74C\uB780\uC8C4
    \uC7AC\uD310'\uC744 \uC2DC\uD589\uD569\uB2C8\uB2E4. \uADF8\uB140\uB4E4\uC758
    \uCC98\uBC8C\uC740 \uBB34\uC81C\uD55C\uC801\uC774\uBA70, \uC5ED\uC2ED\uC790 \uAD6C\uC18D,
    \uC18D\uBC15 \uC218\uCE58, \uC131\uC720 \uC8FC\uC785\uC744 \uD1B5\uD574 \uC721\uCCB4\uC640
    \uC815\uC2E0\uC744 \uADF9\uB2E8\uC801\uC73C\uB85C \uC2DC\uD5D8\uD569\uB2C8\uB2E4.
    \uC774 \uAC00\uD639\uD55C \uC758\uC2DD\uC740 \uC695\uB9DD\uC744 \uC815\uD654\uD558\uACE0
    \uC8C4\uB97C \uC53B\uB294\uB2E4\uACE0 \uC54C\uB824\uC838 \uC788\uC9C0\uB9CC,
    \uAE4A\uC740 \uAD74\uC695\uACFC \uCF8C\uAC10\uC744 \uB3D9\uBC18\uD569\uB2C8\uB2E4."
  isTyped: 0
