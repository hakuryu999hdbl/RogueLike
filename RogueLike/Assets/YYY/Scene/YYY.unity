  m_Text: "\u5BCC\u5546\u3084\u8CB4\u65CF\u304C\u96C6\u3046\u5974\u96B7\u5E02\u5834\u306E\u76EE\u7389\u2015\u2015\u516C\u958B\u7AF6\u58F2\u3002
    \u53F0\u5EA7\u306B\u62BC\u3057\u4E0A\u3052\u3089\u308C\u305F\u5974\u96B7\u306F\u3001\u6DEB\u3089\u306A\u59FF\u3092\u5F37\u5236\u3055\u308C\u3001\u8CB7\u3044\u624B\u305F\u3061\u306E\u76EE\u306E\u524D\u3067\u54C1\u5B9A\u3081\u3055\u308C\u308B\u3002\u4E73\u623F\u3084\u80A1\u9593\u306E\u70D9\u5370\u3092\u6652\u3057\u3001\u6642\u306B\u300C\u8A66\u7528\u300D\u3092\u53D7\u3051\u306A\u304C\u3089\u4FA1\u683C\u304C\u7AF6\u308A\u4E0A\u304C\u3063\u3066\u3044\u304F\u3002
