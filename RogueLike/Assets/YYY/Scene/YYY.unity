--- !u!114 &1189207684
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1189207682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30AF\u30AF\u2026\u2026\u3053\u3063\u3061\u898B\u3093\u306A\u3088\u3002\u3059\u3050\u306B\u304A\u524D\u3082\u305D\u306E\u53F0\u306B\u4E57\u308B\u3093\u3060\u304B\u3089\u306A"
  C_1: "\u563F\u563F\u2026\u2026\u522B\u8FD9\u4E48\u770B\u7740\u6211\uFF0C\u4F60\u5F88\u5FEB\u4E5F\u4F1A\u8EBA\u4E0A\u8FD9\u5F20\u53F0\u5B50"
  C_2: "\u563F\u563F\u2026\u2026\u5225\u9019\u9EBC\u770B\u6211\uFF0C\u4F60\u99AC\u4E0A\u4E5F\u6703\u88AB\u7D81\u5230\u9019\u5F35\u81FA\u5B50\u4E0A"
  E: "Heh\u2026 don\u2019t look at me like that. You\u2019ll be the next one strapped
    down here."
  K: "\uD06C\uD06C\u2026 \uADF8\uB807\uAC8C \uBCF4\uC9C0 \uB9C8. \uB108\uB3C4 \uACE7
    \uC774 \uC790\uB9AC\uC5D0 \uBB36\uC774\uAC8C \uB420 \uD14C\uB2C8\uAE4C."
  isTyped: 1
