  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3078\u3047\u2026\u2026\u5973\u306E\u30D5\u30EA\u3057\u3066\u3053\u3053\u307E\u3067\u6765\u305F\u304B\u3002\u3060\u3051\u3069\u306A\u3001\u201C\u80A1\u201D\u306F\u3054\u307E\u304B\u305B\u306D\u3047\u3088"
  C_1: "\u54DF\uFF0C\u88C5\u5F97\u633A\u50CF\u7684\u554A\u3002\u4F46\u4F60\u90A3\u80EF\u4E0B\uFF0C\u53EF\u9A97\u4E0D\u4E86\u4EBA"
  C_2: "\u55B2\uFF0C\u626E\u5F97\u633A\u50CF\u561B\u3002\u4F46\u4F60\u80EF\u4E0B\u90A3\u6771\u897F\uFF0C\u53EF\u9A19\u4E0D\u4E86\u4EBA"
  E: "Heh\u2026 dressed like a girl and snuck in? That bulge gives you away, sweetheart."
  K: "\uD5C8\u2026 \uC5EC\uC790 \uD589\uC138\uD558\uACE0 \uB4E4\uC5B4\uC654\uB0D0?
    \uD558\uC9C0\uB9CC \uADF8 \uBC11\uC740 \uBABB \uC18D\uC774\uC9C0."
  isTyped: 1
