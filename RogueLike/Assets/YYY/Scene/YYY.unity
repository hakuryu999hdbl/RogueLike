--- !u!114 &1554245659
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1554245657}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u53EF\u611B\u3044\u9854\u3057\u3066\u2026\u2026\u4F55\uFF1F \u305D\u306E\u670D\u3001\u5BA2\u5F15\u304D\u3067\u3082\u3057\u3066\u308B\u306E\uFF1F"
  C_1: "\u8FD9\u5F20\u8138\u2026\u2026\u5567\u5567\u3002\u4F60\u7A7F\u6210\u8FD9\u6837\uFF0C\u662F\u51FA\u6765\u62C9\u5BA2\u7684\u5417\uFF1F"
  C_2: "\u9019\u81C9\u86CB\u2026\u2026\u5616\u5616\u3002\u4F60\u7A7F\u6210\u9019\u6A23\uFF0C\u662F\u51FA\u4F86\u62C9\u5BA2\u7684\u55CE\uFF1F"
  E: "That cute little face\u2026 what\u2019s with the outfit? Looking for customers
    or what?"
  K: "\uADC0\uC5EC\uC6B4 \uC5BC\uAD74 \uD558\uACE0\uC120\u2026 \uC774 \uC637\uC740
    \uBB50\uC57C? \uC190\uB2D8\uC774\uB77C\uB3C4 \uB04C\uB7EC \uB098\uC628 \uAC70\uC57C?"
  isTyped: 1
