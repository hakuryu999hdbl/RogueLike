--- !u!114 &1144553356
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1144553354}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3042\u306A\u305F\u306F\u4EBA\u9593\u306E\u8CB4\u65CF\u306B\u6355\u3089\u3048\u3089\u308C\u3001\u95D8\u6280\u5834\u3078\u3068\u9023\u308C\u3066\u884C\u304B\u308C\u305F\u306E\u3060\u3002\u5A2F\u697D\u306E\u305F\u3081\u306B\u3001\u5F7C\u3089\u306F\u3042\u306A\u305F\u306B\u6027\u5974\u96B7\u306E\u95D8\u58EB\u3092\u3042\u3066\u304C\u3063\u305F\u3002\u5F7C\u5973\u305F\u3061\u3082\u307E\u305F\u3001\u3042\u306A\u305F\u3068\u540C\u3058\u304F\u6355\u3089\u3048\u3089\u308C\u305F\u5974\u96B7\u3060\u3063\u305F\u2026\u2026"
  C_1: "\u4F60\u88AB\u4EBA\u7C7B\u8D35\u65CF\u6293\u5230\u4E86\u89D2\u6597\u573A\u91CC\u3002\u4E3A\u4E86\u53D6\u4E50\uFF0C\u4ED6\u4EEC\u7ED9\u4F60\u5B89\u6392\u4E86\u6027\u5974\u96B6\u6597\u58EB\u3002\u5979\u4EEC\u548C\u4F60\u4E00\u6837\uFF0C\u4E5F\u662F\u88AB\u6293\u56DE\u6765\u7684\u5974\u96B6\u2026\u2026"
  C_2: "\u4F60\u88AB\u4EBA\u985E\u8CB4\u65CF\u6293\u5230\u4E86\u89D2\u9B25\u5834\u88E1\u3002\u70BA\u4E86\u53D6\u6A02\uFF0C\u4ED6\u5011\u7D66\u4F60\u5B89\u6392\u4E86\u6027\u5974\u96B8\u9B25\u58EB\u3002\u5979\u5011\u548C\u4F60\u4E00\u6A23\uFF0C\u4E5F\u662F\u88AB\u6293\u56DE\u4F86\u7684\u5974\u96B8\u2026\u2026"
  E: "You were captured by the nobles and thrown into the colosseum. For their amusement,
    they pit you against gladiators who were also sex slaves. Like you, they too
    were captives\u2026"
  K: "\uB108\uB294 \uC778\uAC04 \uADC0\uC871\uB4E4\uC5D0\uAC8C \uBD99\uC7A1\uD600
    \uD22C\uAE30\uC7A5\uC5D0 \uB04C\uB824\uAC14\uB2E4. \uADF8\uB4E4\uC758 \uC624\uB77D\uC744
    \uC704\uD574, \uB108\uC5D0\uAC8C \uB9DE\uC124 \uC131\uB178\uC608 \uAC80\uD22C\uC0AC\uB4E4\uC774
    \uBC30\uC815\uB418\uC5C8\uB2E4. \uADF8\uB140\uB4E4 \uB610\uD55C \uB108\uC640
    \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uC7A1\uD600\uC628 \uB178\uC608\uC600\uB2E4\u2026\u2026"
  isTyped: 0
