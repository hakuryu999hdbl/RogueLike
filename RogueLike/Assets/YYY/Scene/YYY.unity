--- !u!114 &1138290318
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1138290316}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u5BCC\u5546\u3084\u8CB4\u65CF\u304C\u96C6\u3046\u5974\u96B7\u5E02\u5834\u306E\u76EE\u7389\u2015\u2015\u516C\u958B\u7AF6\u58F2\u3002
    \u53F0\u5EA7\u306B\u62BC\u3057\u4E0A\u3052\u3089\u308C\u305F\u5974\u96B7\u306F\u3001\u6DEB\u3089\u306A\u59FF\u3092\u5F37\u5236\u3055\u308C\u3001\u8CB7\u3044\u624B\u305F\u3061\u306E\u76EE\u306E\u524D\u3067\u54C1\u5B9A\u3081\u3055\u308C\u308B\u3002\u4E73\u623F\u3084\u80A1\u9593\u306E\u70D9\u5370\u3092\u6652\u3057\u3001\u6642\u306B\u300C\u8A66\u7528\u300D\u3092\u53D7\u3051\u306A\u304C\u3089\u4FA1\u683C\u304C\u7AF6\u308A\u4E0A\u304C\u3063\u3066\u3044\u304F\u3002
    \u6B53\u58F0\u3068\u7B11\u58F0\u306B\u5305\u307E\u308C\u308B\u4E2D\u3001\u5F7C\u5973\u305F\u3061\u306F\u5546\u54C1\u3068\u3057\u3066\u65B0\u305F\u306A\u4E3B\u4EBA\u3078\u58F2\u308A\u6E21\u3055\u308C\u308B\u3002"
  C_1: "\u5BCC\u5546\u4E0E\u8D35\u65CF\u6C47\u805A\u7684\u5974\u96B6\u5E02\u573A\u76DB\u4E8B\uFF0C\u516C\u5F00\u62CD\u5356\u3002
    \u88AB\u63A8\u4E0A\u53F0\u5EA7\u7684\u5974\u96B6\uFF0C\u88AB\u8FEB\u4EE5\u6DEB\u9761\u7684\u59FF\u6001\u5C55\u9732\uFF0C\u5728\u4E70\u5BB6\u9762\u524D\u4EFB\u4EBA\u54C1\u8BC4\u3002
    \u4E73\u623F\u4E0E\u4E0B\u4F53\u7684\u70D9\u5370\u88AB\u516C\u5F00\u793A\u4F17\uFF0C\u6709\u65F6\u751A\u81F3\u8981\u201C\u8BD5\u7528\u201D\u540E\u518D\u7ADE\u4EF7\u3002
    \u5728\u6B22\u547C\u4E0E\u7B11\u58F0\u4E2D\uFF0C\u5979\u4EEC\u88AB\u5F53\u4F5C\u5546\u54C1\u5356\u7ED9\u65B0\u7684\u4E3B\u4EBA\u3002"
  C_2: "\u5BCC\u5546\u8207\u8CB4\u65CF\u9F4A\u805A\u7684\u5974\u96B8\u5E02\u5834\u76DB\u4E8B\uFF0C\u516C\u958B\u62CD\u8CE3\u3002
    \u88AB\u63A8\u4E0A\u53F0\u5EA7\u7684\u5974\u96B8\uFF0C\u88AB\u8FEB\u4EE5\u6DEB\u9761\u7684\u59FF\u614B\u5C55\u9732\uFF0C\u5728\u8CB7\u5BB6\u9762\u524D\u4EFB\u4EBA\u54C1\u8A55\u3002
    \u4E73\u623F\u8207\u4E0B\u9AD4\u7684\u70D9\u5370\u88AB\u516C\u958B\u793A\u773E\uFF0C\u6709\u6642\u751A\u81F3\u8981\u300C\u8A66\u7528\u300D\u5F8C\u518D\u7AF6\u50F9\u3002
    \u5728\u6B61\u547C\u8207\u7B11\u8072\u4E2D\uFF0C\u5979\u5011\u88AB\u7576\u4F5C\u5546\u54C1\u8CE3\u7D66\u65B0\u7684\u4E3B\u4EBA\u3002"
  E: "The highlight of the slave market, where merchants and nobles gather\u2014the
    public auction. Slaves are forced onto platforms, displayed in obscene poses,
    appraised by buyers."
  K: "\uBD80\uC720\uD55C \uC0C1\uC778\uACFC \uADC0\uC871\uB4E4\uC774 \uBAA8\uC774\uB294
    \uB178\uC608 \uC2DC\uC7A5\uC758 \uD558\uC774\uB77C\uC774\uD2B8\u2015\u2015\uACF5\uAC1C
    \uACBD\uB9E4. \uB178\uC608\uB294 \uB2E8\uC0C1 \uC704\uB85C \uBC00\uB824 \uC62C\uB77C\uAC00
    \uC678\uC124\uC2A4\uB7EC\uC6B4 \uC790\uC138\uB97C \uAC15\uC694\uB2F9\uD558\uBA70,
    \uAD6C\uB9E4\uC790\uB4E4 \uC55E\uC5D0\uC11C \uD488\uD3C9\uB2F9\uD55C\uB2E4. \uAC00\uC2B4\uACFC
    \uC0AC\uD0C0\uAD6C\uB2C8\uC758 \uB099\uC778\uC774 \uB4DC\uB7EC\uB098\uACE0, \uB54C\uB85C\uB294
    \u201C\uC2DC\uD5D8 \uC0AC\uC6A9\u201D\uC744 \uAC70\uCCD0 \uAC00\uACA9\uC774 \uCE58\uC19F\uB294\uB2E4.
    \uD658\uD638\uC640 \uC6C3\uC74C \uC18D\uC5D0\uC11C, \uADF8\uB140\uB4E4\uC740
    \uC0C1\uD488\uC73C\uB85C\uC11C \uC0C8\uB85C\uC6B4 \uC8FC\uC778\uC5D0\uAC8C \uD314\uB824\uAC04\uB2E4."
  isTyped: 0
