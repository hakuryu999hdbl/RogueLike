--- !u!114 &2038898031
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2038898029}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u30F4\u30A1\u30EB\u30C9\u30EA\u30A2\u5E1D\u56FD\u306E\u738B\u5973\u306B\u3057\u3066\u3001\u60AA\u9B54\u306E\u8840\u3092\u5F15\u304F\u51B7\u9177\u306A\u308B\u652F\u914D\u8005\u3002
    \u305D\u306E\u5FAE\u7B11\u307F\u306E\u88CF\u306B\u306F\u3001\u8AB0\u3082\u6297\u3048\u306C\u7D76\u5BFE\u7684\u306A\u652F\u914D\u6B32\u304C\u6F5C\u3080\u3002
    \u5F7C\u5973\u306B\u3068\u3063\u3066\u300C\u611B\u73A9\u300D\u3068\u306F\u611B\u3067\u3082\u60C5\u3067\u3082\u306A\u304F\u3001\u5B8C\u5168\u306A\u308B\u652F\u914D\u306E\u8A3C\u3002
    \u81E3\u4E0B\u3082\u6355\u865C\u3082\u3001\u5F7C\u5973\u306E\u8208\u5473\u304C\u5C3D\u304D\u308B\u307E\u3067\u3001\u305D\u306E\u638C\u306E\u4E2D\u3067\u58CA\u308C\u3066\u3044\u304F\u3002"
  C_1: "\u74E6\u5C14\u591A\u8389\u4E9A\u5E1D\u56FD\u7684\u738B\u5973\uFF0C\u7EE7\u627F\u4E86\u6076\u9B54\u8840\u8109\u7684\u51B7\u9177\u652F\u914D\u8005\u3002
    \u5979\u7684\u5FAE\u7B11\u4E0B\u9690\u85CF\u7740\u65E0\u4EBA\u80FD\u6297\u62D2\u7684\u652F\u914D\u6B32\u3002
    \u6240\u8C13\u7684\u201C\u73A9\u5177\u201D\uFF0C\u5BF9\u5979\u800C\u8A00\u65E2\u975E\u7231\uFF0C\u4E5F\u975E\u601C\u60AF\uFF0C\u800C\u662F\u7EDD\u5BF9\u6743\u529B\u7684\u8C61\u5F81\u3002
    \u65E0\u8BBA\u662F\u81E3\u5C5E\u8FD8\u662F\u4FD8\u864F\uFF0C\u53EA\u8981\u88AB\u5979\u9009\u4E2D\uFF0C\u7EC8\u5C06\u5316\u4E3A\u7834\u788E\u7684\u4F9B\u7269\u3002"
  C_2: "\u74E6\u723E\u591A\u8389\u4E9E\u5E1D\u570B\u7684\u738B\u5973\uFF0C\u64C1\u6709\u60E1\u9B54\u8840\u7D71\u7684\u51B7\u9177\u652F\u914D\u8005\u3002
    \u5979\u90A3\u67D4\u548C\u7684\u7B11\u5BB9\u80CC\u5F8C\uFF0C\u6F5B\u85CF\u8457\u7121\u6CD5\u6297\u62D2\u7684\u652F\u914D\u617E\u671B\u3002
    \u5C0D\u5979\u800C\u8A00\u6240\u8B02\u7684\u300C\u73A9\u5177\u300D\uFF0C\u65E2\u975E\u611B\u60C5\u4E5F\u975E\u6190\u61AB\uFF0C\u800C\u662F\u6B0A\u529B\u7684\u5370\u8A18\u3002
    \u7121\u8AD6\u81E3\u50D5\u6291\u6216\u4FD8\u865C\uFF0C\u53EA\u8981\u843D\u5165\u5979\u624B\uFF0C\u7D42\u5C07\u6210\u70BA\u7834\u788E\u7684\u737B\u796D\u3002"
  E: "Princess of the Valdoria Empire \u2014 a ruler born from demonic lineage. Behind
    her gentle smile lies an insatiable lust for control. To her, a \u201Ctoy\u201D
    is neither love nor mercy, but the embodiment of absolute dominance. Those who
    catch her eye, whether servant or captive, inevitably crumble within her grasp."
  K: "\uBC1C\uB3C4\uB9AC\uC544 \uC81C\uAD6D\uC758 \uACF5\uC8FC\uC774\uC790, \uC545\uB9C8\uC758
    \uD608\uD1B5\uC744 \uC774\uC5B4\uBC1B\uC740 \uB0C9\uD639\uD55C \uC9C0\uBC30\uC790.
    \uADF8 \uBBF8\uC18C \uB4A4\uC5D0\uB294 \uB204\uAD6C\uB3C4 \uAC70\uC2A4\uB97C
    \uC218 \uC5C6\uB294 \uC9C0\uBC30\uC695\uC774 \uC228\uC5B4 \uC788\uB2E4. \uADF8\uB140\uC5D0\uAC8C
    \u2018\uC7A5\uB09C\uAC10\u2019\uC774\uB780 \uC0AC\uB791\uB3C4 \uC5F0\uBBFC\uB3C4
    \uC544\uB2CC, \uC808\uB300 \uAD8C\uB825\uC758 \uC0C1\uC9D5\uC774\uB2E4. \uC2E0\uD558\uB4E0
    \uD3EC\uB85C\uB4E0, \uADF8\uB140\uC758 \uC190\uC544\uADC0\uC5D0 \uB4E4\uC5B4\uC628
    \uC790\uB294 \uACB0\uAD6D \uC0B0\uC0B0\uC774 \uBD80\uC11C\uC9C0\uACE0 \uB9CC\uB2E4."
  isTyped: 0
