--- !u!114 &2044695067
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2044695065}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3042\u3089\u2026\u2026\u5815\u3061\u305F\u59EB\u304B\u3068\u601D\u3063\u305F\u3089\u3001\u7537\u306E\u5B50\uFF1F
    \u3075\u3075\u3001\u3082\u3063\u3068\u6C17\u306B\u5165\u3063\u305F\u308F"
  C_1: "\u54CE\u5440\u2026\u2026\u6211\u8FD8\u4EE5\u4E3A\u662F\u5815\u843D\u7684\u516C\u4E3B\uFF0C\u7ED3\u679C\u662F\u4E2A\u7537\u5B69\u5B50\uFF1F\u6211\u66F4\u559C\u6B22\u4E86\u5462"
  C_2: "\u54CE\u5440\u2026\u2026\u6211\u9084\u4EE5\u70BA\u662F\u58AE\u843D\u7684\u516C\u4E3B\uFF0C\u7D50\u679C\u662F\u500B\u7537\u5B69\uFF1F\u6211\u66F4\u611B\u4E86\u2661"
  E: "Oh\u2026 I thought you were a fallen princess. But a boy? I like it even more~"
  K: "\uC5B4\uBA38\u2026 \uD0C0\uB77D\uD55C \uACF5\uC8FC\uC778 \uC904 \uC54C\uC558\uB294\uB370,
    \uB0A8\uC790\uC560\uC600\uB124? \uB354 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4~"
  isTyped: 1
