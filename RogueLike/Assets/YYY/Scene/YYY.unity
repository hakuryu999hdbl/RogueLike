--- !u!114 &991480242
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 991480240}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3042\u306A\u305F\u306F\u4EBA\u9593\u306E\u8CB4\u65CF\u306B\u6355\u3089\u3048\u3089\u308C\u3001\u95D8\u6280\u5834\u3078\u3068\u9023\u308C\u3066\u884C\u304B\u308C\u305F\u306E\u3060\u3002\u5A2F\u697D\u306E\u305F\u3081\u306B\u3001\u5F7C\u3089\u306F\u3042\u306A\u305F\u306B\u6027\u5974\u96B7\u306E\u95D8\u58EB\u3092\u3042\u3066\u304C\u3063\u305F\u3002\u5F7C\u5973\u305F\u3061\u3082\u307E\u305F\u3001\u3042\u306A\u305F\u3068\u540C\u3058\u304F\u6355\u3089\u3048\u3089\u308C\u305F\u5974\u96B7\u3060\u3063\u305F\u2026\u2026<color=#FF0000>\u203B\u3053\u306E\u30E2\u30FC\u30C9\u3067\u306F\u30D1\u30FC\u30C6\u30A3\u3010\u5168\u54E1\u3011\u304C\u53C2\u6226\u3057\u307E\u3059\u3002</color>"
  C_1: "\u4F60\u88AB\u4EBA\u7C7B\u8D35\u65CF\u6293\u5230\u4E86\u89D2\u6597\u573A\u91CC\u3002\u4E3A\u4E86\u53D6\u4E50\uFF0C\u4ED6\u4EEC\u7ED9\u4F60\u5B89\u6392\u4E86\u6027\u5974\u96B6\u6597\u58EB\u3002\u5979\u4EEC\u548C\u4F60\u4E00\u6837\uFF0C\u4E5F\u662F\u88AB\u6293\u56DE\u6765\u7684\u5974\u96B6\u2026\u2026<color=#FF0000>\u203B\u672C\u6A21\u5F0F\u4E2D\u961F\u4F0D\u3010\u5168\u5458\u3011\u5C06\u5171\u540C\u53C2\u6218\u3002</color>"
  C_2: "\u4F60\u88AB\u4EBA\u985E\u8CB4\u65CF\u6293\u5230\u4E86\u89D2\u9B25\u5834\u88E1\u3002\u70BA\u4E86\u53D6\u6A02\uFF0C\u4ED6\u5011\u7D66\u4F60\u5B89\u6392\u4E86\u6027\u5974\u96B8\u9B25\u58EB\u3002\u5979\u5011\u548C\u4F60\u4E00\u6A23\uFF0C\u4E5F\u662F\u88AB\u6293\u56DE\u4F86\u7684\u5974\u96B8\u2026\u2026<color=#FF0000>\u203B\u672C\u6A21\u5F0F\u4E2D\u968A\u4F0D\u3010\u5168\u54E1\u3011\u5C07\u5171\u540C\u53C3\u6230\u3002</color>"
  E: "You were captured by the nobles and thrown into the colosseum. For their amusement,
    they pit you against gladiators who were also sex slaves. Like you, they too
    were captives\u2026<color=#FF0000>\u203BAll members of your party will participate
    in this mode.</color>"
