  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u9003\u3052\u3066\u3082\u30E0\u30C0\u3060\u3002\u30AA\u30EC\u306E\u201C\u68D2\u201D\u306E\u990C\u98DF\u306B\u306A\u308B\u306E\u306F\u6642\u9593\u306E\u554F\u984C\u3060\u305C\uFF1F"
  C_1: "\u4F60\u9003\u4E0D\u6389\u7684\uFF0C\u8FDF\u65E9\u90FD\u5F97\u5C1D\u5C1D\u6211\u7684\u2018\u5BB6\u4F19\u2019\u6ECB\u5473"
  C_2: "\u4F60\u662F\u9003\u4E0D\u6389\u7684\uFF0C\u9072\u65E9\u8981\u5617\u5617\u6211\u7684\u2018\u50A2\u4F19\u2019\u5473\u9053"
  E: "You can run, but it's only a matter of time before you taste my \u2018stick\u2019."
  K: "\uB3C4\uB9DD\uCCD0\uBD24\uC790\uC57C. \uB0B4 \u2018\uBB3C\uAC74\u2019 \uB9DB\uBCF4\uB294
    \uAC74 \uC2DC\uAC04 \uBB38\uC81C\uB2C8\uAE4C."
  isTyped: 1
