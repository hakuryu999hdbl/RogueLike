--- !u!114 &15858212
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 15858210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u304F\u3063\u304F\u3063\u304F\u2026\u2026\u3053\u3093\u306A\u53EF\u611B\u3044\u7537\u304C\u3044\u308B\u3068\u306F\u306A\u3002\u8210\u3081\u308B\u306E\u304B\u3001\u5B32\u3089\u308C\u308B\u306E\u304B\u3001\u9078\u3070\u305B\u3066\u3084\u308B\u3088"
  C_1: "\u54FC\u54FC\u2026\u2026\u6CA1\u60F3\u5230\u8FD8\u6709\u8FD9\u4E48\u53EF\u7231\u7684\u7537\u5B69\u3002\u60F3\u8214\u8FD8\u662F\u60F3\u88AB\u73A9\uFF1F\u9009\u4E00\u4E2A\u5427"
  C_2: "\u54FC\u54FC\u2026\u2026\u6C92\u60F3\u5230\u9084\u6709\u9019\u9EBC\u53EF\u611B\u7684\u7537\u5B69\u3002\u8981\u8214\u9084\u662F\u88AB\u73A9\uFF1F\u81EA\u5DF1\u9078\u5427"
  E: "Keh keh\u2026 a cutie like you, huh? Want to lick, or be toyed with? I'll let
    you choose."
  K: "\uD06D\uD06D\u2026 \uC774\uB807\uAC8C \uADC0\uC5EC\uC6B4 \uB0A8\uC790\uC560\uAC00
    \uC788\uB2E4\uB2C8. \uD565\uC744\uB798? \uC544\uB2C8\uBA74 \uB2F9\uD560\uB798?
    \uACE8\uB77C\uBD10\uB77C."
  isTyped: 1
