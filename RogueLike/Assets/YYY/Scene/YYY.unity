--- !u!114 &1221550923
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1221550921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u5E1D\u56FD\u6CD5\u5178\u306B\u57FA\u3065\u304F\u300C\u4EBA\u6A29\u5265\u596A\u300D\u306E\u5211\u3002
    \u9996\u67B7\u306B\u56FA\u5B9A\u3055\u308C\u305F\u5974\u96B7\u306F\u3001\u819D\u3092\u3064\u304D\u5C3B\u3092\u7A81\u304D\u51FA\u3057\u305F\u59FF\u52E2\u3067\u5E83\u5834\u306B\u4E26\u3079\u3089\u308C\u308B\u3002
    \u5224\u6C7A\u304C\u5BA3\u544A\u3055\u308C\u305F\u5F8C\u3001\u5175\u58EB\u3084\u5E02\u6C11\u304C\u5217\u3092\u6210\u3057\u3066\u8FB1\u3081\u3001\u786C\u8CA8\u3092\u6295\u3052\u4E0E\u3048\u308B\u3002
    \u6C38\u4E45\u306B\u7D9A\u304F\u6027\u5974\u96B7\u306E\u751F\u6DAF\u3092\u5F37\u5236\u3055\u308C\u3001\u62B5\u6297\u306E\u4F59\u5730\u306A\u304F\u7FA4\u8846\u306E\u6170\u307F\u7269\u3068\u306A\u308B\u3002"
  C_1: "\u5E1D\u56FD\u6CD5\u5178\u89C4\u5B9A\u7684\u201C\u5265\u593A\u4EBA\u6743\u201D\u5211\u7F5A\u3002
    \u88AB\u56FA\u5B9A\u5728\u9996\u67B7\u4E2D\u7684\u5974\u96B6\uFF0C\u4EE5\u8DEA\u5730\u7FD8\u81C0\u7684\u59FF\u52BF\u9648\u5217\u5728\u5E7F\u573A\u3002
    \u5224\u51B3\u5BA3\u544A\u540E\uFF0C\u58EB\u5175\u4E0E\u5E02\u6C11\u6392\u961F\u51CC\u8FB1\uFF0C\u5E76\u5C06\u786C\u5E01\u629B\u63B7\u5728\u5979\u4EEC\u8EAB\u4E0A\u3002
    \u5979\u4EEC\u88AB\u8FEB\u8FDB\u5165\u6C38\u4E45\u7684\u6027\u5974\u751F\u6DAF\uFF0C\u6BEB\u65E0\u62B5\u6297\u4F59\u5730\uFF0C\u53EA\u80FD\u6210\u4E3A\u7FA4\u4F53\u7684\u73A9\u7269\u3002"
  C_2: "\u5E1D\u570B\u6CD5\u5178\u898F\u5B9A\u7684\u300C\u525D\u596A\u4EBA\u6B0A\u300D\u5211\u7F70\u3002
    \u88AB\u56FA\u5B9A\u5728\u9996\u67B7\u4E2D\u7684\u5974\u96B8\uFF0C\u4EE5\u8DEA\u5730\u7FF9\u81C0\u7684\u59FF\u52E2\u9673\u5217\u65BC\u5EE3\u5834\u3002
    \u5224\u6C7A\u5BA3\u544A\u5F8C\uFF0C\u58EB\u5175\u8207\u5E02\u6C11\u6392\u968A\u51CC\u8FB1\uFF0C\u4E26\u5C07\u786C\u5E63\u6295\u64F2\u65BC\u5979\u5011\u8EAB\u4E0A\u3002
    \u5979\u5011\u88AB\u8FEB\u904E\u8457\u6C38\u4E45\u7684\u6027\u5974\u751F\u6DAF\uFF0C\u6BEB\u7121\u53CD\u6297\u4E4B\u529B\uFF0C\u53EA\u80FD\u6DEA\u70BA\u7FA4\u773E\u7684\u6170\u85C9\u54C1\u3002"
  E: Slaves fixed in pillories are forced to kneel, hips raised, displayed in the
    public square. After the sentence is declared, soldiers and citizens form lines
    to violate them, tossing coins as payment.
  K: "\uC81C\uAD6D \uBC95\uC804\uC5D0 \uB530\uB978 \u201C\uC778\uAD8C \uBC15\uD0C8\u201D
    \uD615\uBC8C. \uC218\uAC11\uD2C0\uC5D0 \uACE0\uC815\uB41C \uB178\uC608\uB4E4\uC740
    \uBB34\uB98E \uAFC7\uACE0 \uC5C9\uB369\uC774\uB97C \uCE58\uCF1C\uB4E0 \uC790\uC138\uB85C
    \uAD11\uC7A5\uC5D0 \uB298\uC5B4\uC11C \uC788\uB2E4. \uD310\uACB0 \uC120\uACE0
    \uD6C4, \uBCD1\uC0AC\uC640 \uC2DC\uBBFC\uB4E4\uC774 \uC904\uC744 \uC11C\uC11C
    \uB2A5\uC695\uD558\uBA70 \uB3D9\uC804\uC744 \uB358\uC9C4\uB2E4. \uADF8\uB4E4\uC740
    \uC601\uAD6C\uD55C \uC131\uB178\uC608\uC758 \uC0B6\uC744 \uAC15\uC694\uB2F9\uD558\uBA70,
    \uC800\uD56D\uD560 \uC218 \uC5C6\uB294 \uAD70\uC911\uC758 \uB180\uC787\uAC10\uC774
    \uB41C\uB2E4."
  isTyped: 0
