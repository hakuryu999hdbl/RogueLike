  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u304A\u3046\u3001\u307E\u305F\u65B0\u5165\u308A\u304B\uFF1F\u2026\u2026\u3078\u3047\u3001\u9854\u3082\u30B1\u30C4\u3082\u4E0A\u7269\u3058\u3083\u306D\u3047\u304B"
  C_1: "\u54DF\uFF0C\u53C8\u6765\u65B0\u4EBA\u4E86\uFF1F\u2026\u2026\u563F\uFF0C\u8FD9\u8138\u86CB\u548C\u5C41\u80A1\uFF0C\u7EDD\u4E86"
  C_2: "\u54CE\u5440\uFF0C\u53C8\u4F86\u65B0\u4EBA\u4E86\uFF1F\u2026\u2026\u563F\uFF0C\u9019\u81C9\u86CB\u8DDF\u5C41\u80A1\uFF0C\u771F\u4E0A\u7B49\u554A"
  E: "Well, look what we have here\u2026 fresh meat. Damn, that face and ass are
    top-class."
  K: "\uC624\uD638\uB77C, \uB610 \uC2E0\uCC38\uC778\uAC00? \u2026\uC5BC\uAD74\uC774\uB791
    \uC5C9\uB369\uC774, \uB05D\uB0B4\uC8FC\uB124."
  isTyped: 1
