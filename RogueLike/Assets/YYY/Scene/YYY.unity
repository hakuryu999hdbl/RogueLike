  m_Text: "\u30F4\u30A1\u30EB\u30C9\u30EA\u30A2\u5E1D\u56FD\u306E\u738B\u5973\u306B\u3057\u3066\u3001\u60AA\u9B54\u306E\u8840\u3092\u5F15\u304F\u51B7\u9177\u306A\u308B\u652F\u914D\u8005\u3002\n\u305D\u306E\u5FAE\u7B11\u307F\u306E\u88CF\u306B\u306F\u3001\u8AB0\u3082\u6297\u3048\u306C\u7D76\u5BFE\u7684\u306A\u652F\u914D\u6B32\u304C\u6F5C\u3080\u3002\n\u5F7C\u5973\u306B\u3068\u3063\u3066\u300C\u611B\u73A9\u300D\u3068\u306F\u611B\u3067\u3082\u60C5\u3067\u3082\u306A\u304F\u3001\u5B8C\u5168\u306A\u308B\u652F\u914D\u306E\u8A3C\u3002\n\u81E3\u4E0B\u3082\u6355\u865C\u3082\u3001\u5F7C\u5973\u306E\u8208\u5473\u304C\u5C3D\u304D\u308B\u307E\u3067\u3001\u305D\u306E\u638C\u306E\u4E2D\u3067\u58CA\u308C\u3066\u3044\u304F\u3002"
