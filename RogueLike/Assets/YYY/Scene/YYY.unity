--- !u!114 &254621843
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 254621841}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u5BB0\u76F8\u30E2\u30EB\u30AC\u30F3\u306E\u5730\u4E0B\u7814\u7A76\u533A\u753B\u3067\u306F\u3001\u4EBA\u3068\u9B54\u306E\u5883\u754C\u3092\u8D8A\u3048\u308B\u7981\u5FCC\u306E\u5B9F\u9A13\u304C\u9032\u3081\u3089\u308C\u3066\u3044\u305F\u3002
    \u5BC4\u751F\u751F\u547D\u3092\u5BBF\u3057\u305F\u5C11\u5973\u3068\u3001\u305D\u306E\u9B42\u3092\u5206\u304B\u3061\u5408\u3046\u5C11\u5E74\u3002
    \u4E8C\u4EBA\u306E\u518D\u4F1A\u306F\u6551\u3044\u3067\u306F\u306A\u304F\u3001\u6B21\u306A\u308B\u300C\u9B54\u7269\u300D\u3092\u751F\u3080\u305F\u3081\u306E\u5100\u5F0F\u3060\u3063\u305F\u3002"
  C_1: "\u5BB0\u76F8\u6469\u5C14\u6839\u7684\u5730\u4E0B\u7814\u7A76\u6240\u4E2D\uFF0C\u6B63\u5728\u8FDB\u884C\u7740\u8DE8\u8D8A\u4EBA\u7C7B\u4E0E\u9B54\u65CF\u754C\u9650\u7684\u7981\u5FCC\u5B9E\u9A8C\u3002
    \u88AB\u9B54\u754C\u5BC4\u751F\u751F\u7269\u4FB5\u8680\u7684\u5C11\u5973\uFF0C\u4E0E\u5979\u91CD\u9022\u7684\u5C11\u5E74\u4E00\u540C\u88AB\u6539\u9020\u6210\u65B0\u7684\u5B9E\u9A8C\u6837\u672C\u3002
    \u4ED6\u4EEC\u7684\u56E2\u5706\uFF0C\u4E0D\u662F\u6551\u8D4E\uFF0C\u800C\u662F\u5B55\u80B2\u66F4\u5F3A\u9B54\u7269\u7684\u4EEA\u5F0F\u3002"
  C_2: "\u5BB0\u76F8\u6469\u723E\u6839\u7684\u5730\u4E0B\u7814\u7A76\u6240\u5167\uFF0C\u9032\u884C\u8457\u8DE8\u8D8A\u4EBA\u8207\u9B54\u4E4B\u754C\u7684\u7981\u5FCC\u5BE6\u9A57\u3002
    \u88AB\u9B54\u754C\u5BC4\u751F\u751F\u7269\u4FB5\u8755\u7684\u5C11\u5973\uFF0C\u8207\u91CD\u9022\u7684\u5C11\u5E74\u4E00\u540C\u6210\u70BA\u65B0\u7684\u5BE6\u9A57\u7D20\u6750\u3002
    \u90A3\u5834\u5718\u805A\uFF0C\u4E26\u975E\u6551\u8D16\uFF0C\u800C\u662F\u5B55\u80B2\u66F4\u5F37\u9B54\u7269\u7684\u5100\u5F0F\u3002"
  E: "In Chancellor Morgan\u2019s underground lab, a forbidden experiment blurs the
    line between man and demon. A girl infected by a parasitic entity\u2026 and the
    boy who reunites with her, only to share her fate."
  K: "\uC7AC\uC0C1 \uBAA8\uB974\uAC04\uC758 \uC9C0\uD558 \uC5F0\uAD6C\uC18C\uC5D0\uC11C\uB294
    \uC778\uAC04\uACFC \uB9C8\uACC4\uC758 \uACBD\uACC4\uB97C \uB118\uC5B4\uC120 \uAE08\uB2E8\uC758
    \uC2E4\uD5D8\uC774 \uC9C4\uD589\uB418\uACE0 \uC788\uC5C8\uB2E4. \uB9C8\uACC4\uC758
    \uAE30\uC0DD \uC0DD\uBA85\uCCB4\uC5D0 \uC7A0\uC2DD\uB41C \uC18C\uB140\uC640,
    \uADF8\uB140\uC640 \uB2E4\uC2DC \uB9CC\uB09C \uC18C\uB144. \uADF8\uB4E4\uC758
    \uC7AC\uD68C\uB294 \uAD6C\uC6D0\uC774 \uC544\uB2C8\uB77C, \uB354 \uAC15\uD55C
    \uB9C8\uBB3C\uC744 \uD0C4\uC0DD\uC2DC\uD0A4\uAE30 \uC704\uD55C \uC758\uC2DD\uC774\uC5C8\uB2E4."
  isTyped: 0
