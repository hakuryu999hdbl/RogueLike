  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u3075\u3080\u2026\u2026\u3053\u3053\u307E\u3067\u6765\u305F\u304B\u3002\u8912\u3081\u3066\u3084\u308D\u3046\u3001\u53CD\u9006\u8005\u3088\u3002"
  C_1: "\u54FC\u2026\u2026\u4F60\u7ADF\u80FD\u8D70\u5230\u8FD9\u91CC\uFF0C\u503C\u5F97\u79F0\u8D5E\u4E86\uFF0C\u53DB\u9006\u8005\u3002"
  C_2: "\u54FC\u2026\u2026\u7ADF\u80FD\u8D70\u5230\u9019\u88E1\uFF0C\u503C\u5F97\u7A31\u8B9A\u4E86\uFF0C\u53DB\u9006\u8005\u3002"
  E: "Hmph... So you\u2019ve made it this far. I\u2019ll give you some credit, rebel."
  K: "\uD760\u2026 \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8, \uCE6D\uCC2C\uD574
    \uC8FC\uC9C0. \uBC18\uC5ED\uC790\uC5EC."
  isTyped: 1
