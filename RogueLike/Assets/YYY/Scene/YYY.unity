--- !u!114 &965965989
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 965965986}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40e240f5b3ea6c44caecad7473b859be, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  J: "\u7537\u3067\u3042\u308A\u306A\u304C\u3089\u5973\u4EE5\u4E0A\u306B\u6DEB\u3089\u2026\u2026\u8CB4\u69D8\u306E\u8089\u4F53\u306F\u73CD\u54C1\u3060\u305E\u3001\u30EB\u30CA!"
  C_1: "\u660E\u660E\u662F\u7537\u4EBA\uFF0C\u5374\u6BD4\u5973\u4EBA\u66F4\u52A0\u5996\u8273\u6DEB\u9761\u2026\u2026\u4F60\u7684\u8EAB\u4F53\u771F\u662F\u7A00\u6709\u7684\u73CD\u54C1\u554A\uFF0C\u9732\u5A1C\u3002"
  C_2: "\u660E\u660E\u662F\u7537\u4EBA\uFF0C\u537B\u6BD4\u5973\u4EBA\u66F4\u52A0\u5996\u8C54\u6DEB\u9761\u2026\u2026\u59B3\u7684\u8EAB\u9AD4\u771F\u662F\u7A00\u6709\u7684\u73CD\u54C1\u554A\uFF0C\u9732\u5A1C\u3002"
  E: "A man, yet more alluring and depraved than any woman\u2026 Your body truly
    is a rare specimen, Luna."
  K: "\uB0A8\uC790\uC774\uBA74\uC11C\uB3C4 \uC5EC\uC790\uBCF4\uB2E4 \uB354 \uC694\uC5FC\uD558\uACE0
    \uD0C0\uB77D\uD588\uAD6C\uB098\u2026\u2026 \uB124 \uC721\uCCB4\uB294 \uC9C4\uADC0\uD55C
    \uD45C\uBCF8\uC774\uB2E4, \uB8E8\uB098!"
  isTyped: 1
